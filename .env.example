# ==============================================================================
# SMTP Configuration for Nodemailer Contact Form
# ==============================================================================

# OPTION 1: Gmail (Recommended for personal portfolios)
# 1. Go to your Google Account (https://myaccount.google.com/security)
# 2. Make sure 2-Step Verification is turned ON
# 3. Go to "App Passwords" (https://myaccount.google.com/apppasswords)
# 4. Create an App name (e.g., "Portfolio Contact Form") and copy the 16-character code
# 5. Paste the email and 16-character code below:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_gmail_app_password

# OPTION 2: Custom SMTP Provider (SendGrid, Mailgun, AWS SES, Resend, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_api_key

# Destination inbox to receive contact submissions
CONTACT_RECEIVER_EMAIL=nahidankur@gmail.com

